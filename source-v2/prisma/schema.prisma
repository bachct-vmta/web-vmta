datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  email_verified_at DateTime?
  password          String
  remember_token    String?
  created_at        DateTime?
  updated_at        DateTime?
}

model Setting {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  value      String?
  type       String    @default("string")
  group      String    @default("general")
  created_at DateTime?
  updated_at DateTime?
}

model Category {
  id         Int                   @id @default(autoincrement())
  slug       String                @unique
  is_active  Boolean               @default(true)
  order      Int                   @default(0)
  created_at DateTime?
  updated_at DateTime?
  translations CategoryTranslation[]
  posts      Post[]
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  category_id Int
  locale      String
  name        String
  description String?
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, locale])
}

model Post {
  id           Int               @id @default(autoincrement())
  category_id  Int?
  slug         String            @unique
  image        String?
  is_active    Boolean           @default(true)
  published_at DateTime?
  created_at   DateTime?
  updated_at   DateTime?
  category     Category?         @relation(fields: [category_id], references: [id])
  translations PostTranslation[]
}

model PostTranslation {
  id         Int     @id @default(autoincrement())
  post_id    Int
  locale     String
  title      String
  excerpt    String?
  content    String?
  seo_title  String?
  seo_desc   String?
  post       Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([post_id, locale])
}

model Page {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  is_active    Boolean           @default(true)
  created_at   DateTime?
  updated_at   DateTime?
  translations PageTranslation[]
}

model PageTranslation {
  id        Int     @id @default(autoincrement())
  page_id   Int
  locale    String
  title     String
  content   String?
  seo_title String?
  seo_desc  String?
  page      Page    @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@unique([page_id, locale])
}

model CmsSection {
  id           Int                     @id @default(autoincrement())
  page_slug    String                  // e.g. 'home', 'about', 'alliance', 'dental', 'products', 'contact'
  section_key  String                  // e.g. 'hero', 'overview', 'standards', 'map', 'offices'
  is_active    Boolean                 @default(true)
  order        Int                     @default(0)
  created_at   DateTime?               @default(now())
  updated_at   DateTime?               @updatedAt
  translations CmsSectionTranslation[]

  @@unique([page_slug, section_key])
}

model CmsSectionTranslation {
  id         Int        @id @default(autoincrement())
  section_id Int
  locale     String     // 'vi' or 'en'
  title      String?
  subtitle   String?
  body       String?
  extra_json String?    // JSON string for complex fields like bullets, items, pillars
  section    CmsSection @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([section_id, locale])
}

model Menu {
  id         Int        @id @default(autoincrement())
  code       String     @unique
  name       String
  created_at DateTime?
  updated_at DateTime?
  items      MenuItem[]
}

model MenuItem {
  id           Int                   @id @default(autoincrement())
  menu_id      Int
  parent_id    Int?
  order        Int                   @default(0)
  url          String?
  target       String                @default("_self")
  created_at   DateTime?
  updated_at   DateTime?
  menu         Menu                  @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  parent       MenuItem?             @relation("MenuItemToParent", fields: [parent_id], references: [id])
  children     MenuItem[]            @relation("MenuItemToParent")
  translations MenuItemTranslation[]
}

model MenuItemTranslation {
  id           Int      @id @default(autoincrement())
  menu_item_id Int
  locale       String
  title        String
  menu_item    MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@unique([menu_item_id, locale])
}

model Inquiry {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String
  email      String?
  service    String?
  message    String?
  status     String    @default("pending")
  created_at DateTime?
  updated_at DateTime?
}

model DentalService {
  id           Int                        @id @default(autoincrement())
  slug         String                     @unique
  image        String?
  price        String?
  is_active    Boolean                    @default(true)
  order        Int                        @default(0)
  created_at   DateTime?
  updated_at   DateTime?
  translations DentalServiceTranslation[]
}

model DentalServiceTranslation {
  id                Int           @id @default(autoincrement())
  dental_service_id Int
  locale            String
  name              String
  description       String?
  content           String?
  dental_service    DentalService @relation(fields: [dental_service_id], references: [id], onDelete: Cascade)

  @@unique([dental_service_id, locale])
}

model NewsletterSubscriber {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  created_at DateTime?
  updated_at DateTime?
}
