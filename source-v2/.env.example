# ===================================================
# VMTA PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy these values into Vibe Host / Vercel / VPS .env
# ===================================================
APP_ENV="production"
NODE_ENV="production"

# Web Domain Config
NEXT_PUBLIC_APP_NAME="VMTA"
NEXT_PUBLIC_APP_URL="https://vmta.vn"

# PostgreSQL Database Connection String (From Vibe Host / Supabase)
DATABASE_URL="postgresql://user_vmta:password@v2.tinhgon.xyz:5432/vmta_db?sslmode=require"

# ☁️ Cloud Storage CDN (Option 2 - Cloudinary)
USE_CLOUD_STORAGE="true"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email SMTP Notification Settings
INQUIRY_ADMIN_EMAIL="vmta@vmta.vn"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="vmta@vmta.vn"
SMTP_PASS="your-16-char-app-password"

# Google Translate & Security
GOOGLE_TRANSLATE_KEY="AIzaSyATBXajvzQLTDHEQbcpq0Ihe0vWDHmO520"
JWT_SECRET="vmta_production_super_secret_jwt_key_2026"
